DATABASE_URL= # PostgreSQL connection string, e.g. postgresql://user:password@host:5432/db_name — from your database provider (or local/Docker Postgres instance)
NEXTAUTH_SECRET= # Random secret used to encrypt NextAuth sessions/JWTs — generate with `openssl rand -base64 32`
NEXTAUTH_URL= # Base URL of your app, e.g. http://localhost:3000 in development
GMAIL_USER= # Gmail address Nodemailer sends from
GMAIL_PASS= # Gmail App Password for GMAIL_USER — generate at https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
REDIS_URL= # Redis connection string used for rate limiting, e.g. redis://user:password@host:6379 — from your Redis provider (or local/Docker Redis instance)

# Flutterwave Payment Keys (get these from your Flutterwave dashboard in test mode)
FLUTTERWAVE_PUBLIC_KEY= # Flutterwave public API key, used client-side to initialize payments
FLUTTERWAVE_SECRET_KEY= # Flutterwave secret API key, used server-side to authenticate SDK/API calls
FLUTTERWAVE_WEBHOOK_SECRET= # Secret hash configured in your Flutterwave dashboard webhook settings — used to verify incoming webhook signatures

# Qilo Pro Plan Pricing (stored in kobo — multiply Naira by 100)
PRO_MONTHLY_PRICE_MINOR=500000 # Pro monthly plan price in kobo (e.g. 500000 = ₦5,000)
PRO_YEARLY_PRICE_MINOR=5000000 # Pro yearly plan price in kobo (e.g. 5000000 = ₦50,000)

# Plan names
PRO_MONTHLY_PLAN_NAME=Qilo Pro Monthly # Display name for the monthly Pro plan
PRO_YEARLY_PLAN_NAME=Qilo Pro Yearly # Display name for the yearly Pro plan
